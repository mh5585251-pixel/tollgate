{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": "apps/saas",
      "framework": "nextjs"
    },
    "collector": {
      "root": "apps/collector",
      "runtime": "node",
      "entrypoint": "src/main.ts",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "SAAS_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
